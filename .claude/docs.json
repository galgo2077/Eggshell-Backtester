{
  "src_dirs": ["src", "strategies"],
  "docs_dir": "docs",
  "inject": ["estructura.mmd", "analysis.md", "docker.mmd"],
  "subgraphs": [
    { "prefix": "ui/",               "id": "UI",      "label": "UI Layer" },
