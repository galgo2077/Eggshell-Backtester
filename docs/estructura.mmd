    OLLAMA["ollama · localhost:11434 · qwen2.5:0.5b + 0xroyce/plutus:latest"]
    N8N["n8n · localhost:5678 · webhook automation"]
  end

  subgraph DOCKER["Docker Image / Runtime (systemd PID 1)"]
    OLLAMASVC["ollama.service · AI engine"]
    N8NSVC["n8n.service · workflow automation · :5678"]
    REPSVC["reports-server.service · python http.server :8080 → /app/reports"]
  end

  subgraph REPORTS["reports/  (git-ignored content, dirs tracked via .gitkeep)"]
    RCHARTS["charts/ · live HTML charts (overwritten each run)"]
