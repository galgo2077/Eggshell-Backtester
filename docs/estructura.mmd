flowchart TD

  MAIN["main.py · CLI runner"]

  subgraph UI["UI Layer"]
    TUI["ui/tui.py · BacktestApp"]
    SAVE["_save_backtest() · modal → reports/results/NAME/"]
    LOAD["_load_backtest() · modal → restores full UI state"]
    PIE["_draw_pie_chart() · braille Unicode pie (tab PIE)"]
    ALLOC["#alloc-section · per-asset % inputs (sum=100%)"]
  end

  subgraph CORE["Core Engine"]
    SL["core/signal_logic.py · SignalLogic · on_progress callback"]
    BE["core/backtest_engine.py · BacktestEngine · on_progress(pct, msg)"]
    CONST["core/constants.py · STRATEGY_SCHEMAS / ConnectConstants"]
  end

  subgraph DATA["Binance Data Layer"]
    DF["binance_service/dataframe.py · Dataframe · on_progress callback"]
    CACHE["cache/{SYM}_{interval}.parquet · per-symbol cache files"]
    CONN["binance_service/connect.py · Connect"]
  end

  subgraph STRAT["Strategies"]
    EBS["Elliot_bollinger/strategy.py · ElliotBollingerStrategy"]
    EBC["Elliot_bollinger/constants.py"]
    EMAS["Ema_cross/strategy.py · EMACrossStrategy · on_progress steps"]
    EMAC["Ema_cross/constants.py"]
    strategies___init___py["strategies/__init__.py"]
  end

  subgraph EXT["Third-party"]
    VBT["vectorbt"]
    TEXTUAL["textual"]
    RICH["rich"]
    PLOTLY["plotly"]
    BAPI["python-binance"]
    OLLAMA["ollama (localhost:11434)"]
  end

  subgraph REPORTS["reports/  (git-ignored content, dirs tracked via .gitkeep)"]
    RCHARTS["charts/ · live HTML charts (overwritten each run)"]
    RRESULTS["results/NAME/ · named saved snapshots"]
    RSTATS["  ├─ stats.txt · full metrics log"]
    RTRADES["  ├─ trades.csv · trade records"]
    RJSON["  ├─ results.json · full results dict for reload"]
    RCOPY["  ├─ charts/ · copied HTML charts"]
    RLINKS["  └─ charts_links.html · local file:// hyperlinks"]
    RERR["errors/error.log · runtime errors"]
  end

  subgraph GITIGNORE[".gitignore rules"]
    IGN1["cache/*.parquet  cache/*.pkl"]
    IGN2["reports/charts/*.html"]
    IGN3["reports/errors/error.log"]
    IGN4["reports/results/"]
    IGN5["config/ui_settings.json"]
  end

