    EMAS["Ema_cross/strategy.py · EMACrossStrategy"]
    EMAC["Ema_cross/constants.py"]
  end

  subgraph SUBREPO["strategies/Strategies-eggshell (git submodule)"]
    EBS["Elliot_bollinger/strategy.py · ElliotBollingerStrategy"]
    EBC["Elliot_bollinger/constants.py"]
    SENT["Sentiment_proxy/strategy.py · SentimentProxyStrategy"]
    SENTC["Sentiment_proxy/constants.py"]
  end

  subgraph EXT["Third-party"]
    VBT["vectorbt"]
    TEXTUAL["textual"]
    RICH["rich"]
    PLOTLY["plotly"]
    PANDASTA["pandas-ta-classic · indicators"]
