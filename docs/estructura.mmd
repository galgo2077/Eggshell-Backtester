    RCOPY["  ├─ charts/ · copied HTML charts"]
    RLINKS["  └─ charts_links.html · local file:// hyperlinks"]
    RERR["errors/error.log · runtime errors"]
  end

  subgraph GITIGNORE[".gitignore rules"]
    IGN1["cache/*.parquet  cache/*.pkl"]
