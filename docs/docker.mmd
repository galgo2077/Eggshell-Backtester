    L4["eggshell-fastfetch<br/>docker/Dockerfile.fastfetch<br/>apt: fastfetch (GitHub release)"]
    L5["eggshell-btop<br/>docker/Dockerfile.btop<br/>apt: btop · baked btop.conf profile"]
    L6["eggshell-tmux<br/>docker/Dockerfile.tmux<br/>apt: tmux · baked .tmux.conf<br/>auto-attach on SSH login"]
    L7["eggshell-nvidia<br/>docker/Dockerfile.nvidia<br/>apt: pciutils<br/>ENV NVIDIA_VISIBLE_DEVICES=all<br/>ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility"]
    L8["eggshell-gpu-benchmark<br/>docker/Dockerfile.gpu_benchmark<br/>apt: nvtop<br/>pip: pynvml · gpustat · cupy-cuda12x · nvidia-cublas-cu12<br/>cmd: gpu-benchmark (validation + diagnostics)<br/>cmd: gpu-saturate  (saturation engine)"]
    L9["eggshell-models<br/>docker/Dockerfile.models<br/>ollama pull qwen2.5:0.5b<br/>ollama pull 0xroyce/plutus:latest<br/>models frozen into image layer"]

    L1 --> L2 --> L3 --> L4 --> L5 --> L6 --> L7 --> L8 --> L9
  end

  subgraph APP["App Layers — fast-changing, targeted COPYs"]
    direction TB
    A1["eggshell-systemd<br/>docker/Dockerfile.systemd<br/>COPY systemd/*.service → /etc/systemd/system/<br/>ollama.service · reports-server.service · model-pull.service<br/>OLLAMA_NUM_PARALLEL=8 · FLASH_ATTENTION=1 · KV_CACHE_TYPE=q8_0"]
    A2["eggshell-source<br/>docker/Dockerfile.source<br/>COPY src/ scripts/ config/ status.sh entrypoint.sh<br/>ENV PYTHONPATH · OLLAMA_HOST · NVIDIA_* · NUMEXPR_MAX_THREADS<br/>alias: eggshell → python src/main.py"]
    A3["eggshell-data<br/>docker/Dockerfile.data<br/>ARG BUILD_DATE_1D / 4H / 1H / 15M  ← cache-busted per interval<br/>python scripts/prefetch_data.py --interval 1d/4h/1h/15m<br/>bakes Binance OHLCV cache into image"]
    A4["ghcr.io/galgo2077/eggshell · FINAL<br/>Dockerfile (root)<br/>HEALTHCHECK: curl ollama :11434<br/>ENTRYPOINT: /entrypoint.sh"]

    A1 --> A2 --> A3 --> A4
  end

