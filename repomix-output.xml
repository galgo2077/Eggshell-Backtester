# ── Layer: data ───────────────────────────────────────────────────────────────
# Pre-fetch market data — one cache-bust ARG per interval.
# Order: slowest interval first → a daily tick only busts the 1d layer upward,
# a 15m tick only busts the last layer.
#
#   BUILD_DATE_1D  = YYYY-MM-DD           busts once per day
#   BUILD_DATE_4H  = YYYY-MM-DD-HH        busts every 4 h (hour floored to 0/4/8/12/16/20)
#   BUILD_DATE_1H  = YYYY-MM-DD-HH        busts every hour
#   BUILD_DATE_15M = YYYY-MM-DD-HH-MM     busts every 15 min (minute floored to 0/15/30/45)
FROM eggshell-source:latest

RUN mkdir -p /eggshell/src/binance_service/cache /eggshell/reports

ARG BUILD_DATE_1D=unknown
RUN echo "[data-1d]  build=${BUILD_DATE_1D}"  && python /eggshell/scripts/prefetch_data.py --interval 1d

ARG BUILD_DATE_4H=unknown
RUN echo "[data-4h]  build=${BUILD_DATE_4H}"  && python /eggshell/scripts/prefetch_data.py --interval 4h

ARG BUILD_DATE_1H=unknown
RUN echo "[data-1h]  build=${BUILD_DATE_1H}"  && python /eggshell/scripts/prefetch_data.py --interval 1h

ARG BUILD_DATE_15M=unknown
RUN echo "[data-15m] build=${BUILD_DATE_15M}" && python /eggshell/scripts/prefetch_data.py --interval 15m
</file>

<file path="docker/Dockerfile.gpu_benchmark">
# ── Layer: gpu-benchmark ──────────────────────────────────────────────────────
# GPU validation, diagnostics, and performance benchmark system.
# Installs system monitoring tools + Python GPU libs, then bakes the benchmark
# script so it can be run independently of the final app image:
#   docker run --rm --gpus all eggshell-gpu-benchmark:latest gpu-benchmark
#
# Rebuild only when: monitoring tools or pynvml/gpustat versions change
FROM eggshell-nvidia:latest

# nvtop — real-time GPU monitor (TUI)
# nvidia-cuda-toolkit — provides nvcc (CUDA 12.0, ~167 MB, Ubuntu 24.04 universe)
RUN apt-get update \
    && apt-get install -y --no-install-recommends nvtop nvidia-cuda-toolkit \
    && rm -rf /var/lib/apt/lists/*

# GPU Python libraries — injected into the pre-built venv from eggshell-python
# cupy-cuda12x bundles libcudart so no separate CUDA toolkit install is needed;
# nvidia-container-toolkit provides libcuda.so.1 (driver) at runtime.
RUN /opt/venv/bin/pip install --no-cache-dir \
        "pynvml==11.5.0" \
        "gpustat==1.1.1" \
        "cupy-cuda12x" \
        "nvidia-cublas-cu12"

# Bake scripts into this layer so they are runnable on their own
COPY scripts/benchmark_gpu.py  /usr/local/lib/benchmark_gpu.py
COPY scripts/gpu_saturate.py   /usr/local/lib/gpu_saturate.py

# /usr/local/bin/gpu-benchmark — GPU validation + diagnostics
RUN printf '#!/bin/bash\nexec /opt/venv/bin/python /usr/local/lib/benchmark_gpu.py "$@"\n' \
        > /usr/local/bin/gpu-benchmark \
    && chmod +x /usr/local/bin/gpu-benchmark

# /usr/local/bin/gpu-saturate — GPU saturation engine
RUN printf '#!/bin/bash\nexec /opt/venv/bin/python /usr/local/lib/gpu_saturate.py "$@"\n' \
        > /usr/local/bin/gpu-saturate \
    && chmod +x /usr/local/bin/gpu-saturate

ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility
</file>

<file path="docker/Dockerfile.models">
# ── Layer: models ─────────────────────────────────────────────────────────────
# Bake Ollama models into the image — frozen at build time.
# ollama serve runs during build (CPU only) just to download blobs.
# Models are stored in /root/.ollama/models and available at runtime.
# Rebuild only when: model list or versions change
FROM eggshell-gpu-benchmark:latest

RUN /usr/local/bin/ollama serve & \
    until curl -sf http://localhost:11434/api/tags > /dev/null 2>&1; do sleep 2; done && \
    ollama pull qwen2.5:0.5b && \
    ollama pull 0xroyce/plutus:latest && \
    pkill -f "ollama serve" || true
</file>

<file path="docker/Dockerfile.source">
# ── Layer: source ────────────────────────────────────────────────────────────
# App source code, runtime ENV, eggshell alias, shell setup
# Targeted COPY (not COPY . .) so systemd/docker/ changes don't bust this layer
# Rebuild only when: src/, scripts/, config/, status.sh or entrypoint.sh change
FROM eggshell-systemd:latest

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/eggshell/src:/eggshell/scripts \
    PATH="/opt/venv/bin:$PATH" \
    MPLBACKEND=Agg \
    OLLAMA_HOST=http://localhost:11434 \
    EGGSHELL_HOST=localhost \
    OLLAMA_KEEP_ALIVE=-1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    NUMEXPR_MAX_THREADS=64

WORKDIR /eggshell

COPY src/        /eggshell/src/
COPY scripts/    /eggshell/scripts/
COPY config/     /eggshell/config/
COPY status.sh   /usr/local/bin/status
COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /usr/local/bin/status /entrypoint.sh \
    && printf '#!/bin/bash\ncd /eggshell/src && exec python main.py "$@"\n' \
       > /usr/local/bin/eggshell && chmod +x /usr/local/bin/eggshell \
    && echo 'export TERM=xterm-256color' >> /etc/bash.bashrc \
    && echo 'export LANG=C.UTF-8'        >> /etc/bash.bashrc \
    && echo 'export LC_ALL=C.UTF-8'      >> /etc/bash.bashrc \
    && echo '[ -x /usr/local/bin/gpu-benchmark ] && gpu-benchmark' >> /etc/bash.bashrc \
    && echo '[ -x /usr/local/bin/status ] && /usr/local/bin/status' >> /etc/bash.bashrc
</file>

