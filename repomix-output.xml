        font=dict(color="#e5e7eb"),
        xaxis=dict(title="Synthetic time", gridcolor="#1f2937"),
        yaxis=dict(title="% per bar", gridcolor="#1f2937"),
    )
    fig2.write_html(charts["rw_drift_volatility"])
    return charts
