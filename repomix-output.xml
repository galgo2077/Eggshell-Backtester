    history_options = {
        "1M": "1 month ago",
        "3M": "3 months ago",
        "6M": "6 months ago",
        "1Y": "1 year ago",
        "2Y": "2 years ago",
        "2022": "1 Jan, 2022",
        "2021": "1 Jan, 2021",
        "2020": "1 Jan, 2020",
        "2018": "1 Jan, 2018"
    }
    history_choice = Prompt.ask(
        "History [bold yellow]Depth[/bold yellow]",
        choices=list(history_options.keys()),
