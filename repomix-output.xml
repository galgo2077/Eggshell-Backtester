        init_workers=4, max_workers=10,
        num_ctx=4096,  num_predict=1024,
        req_timeout=120, target_util=75,
    ),
    "aggressive": Mode(
        "aggressive", "AGGRESSIVE",
        init_workers=8, max_workers=20,
        num_ctx=8192,  num_predict=2048,
        req_timeout=180, target_util=85,
    ),
    "maximum": Mode(
